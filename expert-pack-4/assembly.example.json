{
  "version": 1,
  "name": "expert-pack-example",
  "agent": {
    "max_steps": 6,
    "temperature": 0.0,
    "memory_context": true,
    "memory_context_k": 3,
    "seed": 7
  },
  "bindings": [
    {
      "slot": "model",
      "type": "module",
      "target": "expert_pack.adapters.model_openai:from_config",
      "config": {
        "model": "gpt-4o-mini",
        "base_url": "https://api.openai.com/v1",
        "api_key_env": "OPENAI_API_KEY"
      }
    },
    {
      "slot": "tools",
      "type": "mcp_stdio",
      "target": "demo",
      "config": {
        "command": "python",
        "args": ["-m", "expert_pack.builtin.mcp_demo_server"],
        "timeout": 20
      }
    },
    {
      "slot": "skills",
      "type": "skill_dir",
      "target": "expert_pack/builtin/skills"
    },
    {
      "slot": "store",
      "type": "builtin",
      "target": "sqlite",
      "config": {
        "path": ".expert_pack/memory.sqlite3"
      }
    },
    {
      "slot": "policy",
      "type": "builtin",
      "target": "jitrl",
      "config": {
        "beta": 1.0,
        "gamma": 0.5,
        "top_k": 5,
        "min_similarity": 0.4
      }
    },
    {
      "slot": "evaluator",
      "type": "builtin",
      "target": "heuristic"
    }
  ]
}
